# Reference for every environment variable DocsThatRun reads.
#
# NOTE: nothing in this project loads a .env file — there is no python-dotenv
# dependency and no load_dotenv() call anywhere. Copying this to .env only has
# an effect under `docker compose`, which does the ${VAR} substitution itself.
# For the documented local paths (`uvicorn app.main:app`, `python3 -m
# docsthatrun`), export the variables in your shell instead:
#
#     export ANTHROPIC_API_KEY=sk-ant-...
#
# Without a key, everything still runs via the offline MockClient.

# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# DOCSTHATRUN_LLM=anthropic     # anthropic | mock | auto (default: auto)
# DOCSTHATRUN_MODEL=claude-opus-5
# DOCSTHATRUN_EFFORT=medium     # low | medium | high | xhigh | max

# --- LLM client ---
# DOCSTHATRUN_MAX_TOKENS=8192   # shared by adaptive thinking and the JSON answer
# DOCSTHATRUN_LLM_TIMEOUT=60    # seconds per Anthropic call
# DOCSTHATRUN_LLM_RETRIES=2

# --- retrieval / answer ---
# DOCSTHATRUN_DEFAULT_VERSION=v2   # v1 or v2; anything else is rejected at startup
# DOCSTHATRUN_TOP_K=5
# DOCSTHATRUN_TOP_K_MAX=50
# DOCSTHATRUN_MAX_QUESTION_CHARS=2000

# --- sandbox execution limits (each clamped to a sane floor, so a typo can't
#     silently disable a limit or make every snippet report "timed out") ---
# DOCSTHATRUN_SANDBOX_TIMEOUT=20   # wall-clock seconds
# DOCSTHATRUN_SANDBOX_CPU=10       # RLIMIT_CPU seconds
# DOCSTHATRUN_SANDBOX_MEM_MB=1024  # RLIMIT_AS (Linux)
# DOCSTHATRUN_SANDBOX_FILE_MB=10   # RLIMIT_FSIZE

# --- answer cache ---
# DOCSTHATRUN_CACHE_MAX=256        # entries; 0 disables
# DOCSTHATRUN_CACHE_TTL=900        # seconds; 0 disables

# --- rate limiting (per client IP) ---
# DOCSTHATRUN_RATE_RPM=60          # sustained req/min; 0 disables
# DOCSTHATRUN_RATE_BURST=20        # bucket capacity
# DOCSTHATRUN_TRUST_PROXY=0        # key limits on X-Forwarded-For's first hop

# --- server ---
# DOCSTHATRUN_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# DOCSTHATRUN_LOG_LEVEL=INFO
# DOCSTHATRUN_LOG_JSON=true
